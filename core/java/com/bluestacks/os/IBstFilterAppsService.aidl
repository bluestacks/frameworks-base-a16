    boolean isRotateDisabled(String pkgName);
    boolean isUnreal5App(String pkgName);
    boolean isUE5PBDisabled(String pkgName);
    boolean isBptcApp(String pkgName);
    boolean isExtractNativeLibs(String pkgName);
    boolean isEtherNetType(String pkgName);
    String getVkHostInfo(String pkgName);
    String getVKDeviceExtIgnore(String pkgName);
    boolean isDefaultXYDpi(String pkgName);
    int getPScoreAbove(String pkgName);
    boolean isMapBufRangeReadOnceEnabled(String pkgName);
    boolean isFbCompleteCheckDisabled(String pkgName);
}
